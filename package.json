{
  "name": "classroom-handoff",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch server/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx scripts/e2e.ts",
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build-server.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:built && npm run package",
    "test:built": "node scripts/smoke-built.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "release:managed": "node --import tsx scripts/managed-release.ts",
    "test:managed-browser": "node --import tsx scripts/managed-browser-smoke.ts"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "playwright": "^1.56.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
