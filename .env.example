# Local Docker: http://localhost:8787, exposed only on the host loopback.
PORT=8787
PUBLIC_URL=http://localhost:8787

# Production: set a public DNS name pointing at the Linux Docker host.
# Use compose.production.yaml. The backend has no publicly exposed port.
HANDOFF_DOMAIN=handoff.example.org
ACME_EMAIL=admin@example.org

# Accepted commands expire rather than applying unexpectedly much later.
COMMAND_TTL_MS=120000
PAIRING_TTL_MS=300000
# Terminal status metadata retention; payloads are removed on terminal status.
RETENTION_MS=86400000

# For direct Node execution (Docker sets these itself):
# HOST=127.0.0.1
# DATA_DIR=.data
