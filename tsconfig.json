{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023", "DOM"],
    "types": ["node", "chrome"], "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "extension/src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
